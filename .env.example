# Biến môi trường cho Vite. Chép file này thành `.env` rồi điền giá trị.
#
# `.env` KHÔNG được commit (xem .gitignore). Trước đây nó bị track — chỉ chứa
# khoá public nên không phải sự cố bảo mật, nhưng .gitignore lúc đó chỉ có
# `.env.local`, nghĩa là secret thật lần sau sẽ lọt lên remote.
#
# ⚠️ Bản build trên Vercel/CI KHÔNG đọc file này. Ba biến dưới đây phải được
# khai trong phần Environment Variables của nền tảng, nếu không bundle sẽ chạy
# với `undefined` và app chết ngay lúc khởi tạo Supabase client
# ("supabaseUrl is required").

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Secret CHỈ dùng ở máy local đặt trong `.env.local` (đã gitignore qua *.local),
# KHÔNG đặt ở đây và không bao giờ dùng tiền tố VITE_ — mọi biến VITE_ đều bị
# nhúng vào bundle mà trình duyệt đọc được:
#   SUPABASE_SERVICE_ROLE_KEY=...
#   SUPABASE_DB_URI=...
